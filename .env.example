# Server
PORT=3000
UPLOAD_DIR=./uploads

# MySQL (dipakai docker-compose & koneksi Drizzle)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tcse
MYSQL_USER=tcse
MYSQL_PASSWORD=ganti_password_kuat
MYSQL_ROOT_PASSWORD=ganti_root_password_kuat

# Dipakai Drizzle / mysql2 (drizzle.config.ts + db/client.ts)
# Boleh ditulis eksplisit, atau biarkan format ${...} di bawah:
# backend akan merakit URL dari variabel MYSQL_* di atas secara otomatis.
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"
